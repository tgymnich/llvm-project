name: fold_sext_low
legalized: true
regBankSelected: true
body: |
  bb.0:
    successors: %bb.0, %bb.1
    liveins: $x0
    ; CHECK-LABEL: name: fold_sext_low
    ; CHECK-NOT: SBFM
    ; CHECK: TBNZW {{.*}}, 5, %bb.1
    %src:gpr(i64) = COPY $x0
