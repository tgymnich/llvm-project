name:            test_add_i8
alignment:       16
legalized:       true
regBankSelected: false
selected:        false
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
body:             |
  bb.1 (%ir-block.0):
    liveins: $edi, $esi

    ; FAST-LABEL: name: test_add_i8
    ; FAST: liveins: $edi, $esi
    ; FAST-NEXT: {{  $}}
    ; FAST-NEXT: [[COPY:%[0-9]+]]:gpr(i8) = COPY $dil
    ; FAST-NEXT: [[COPY1:%[0-9]+]]:gpr(i8) = COPY $sil
    ; FAST-NEXT: [[ADD:%[0-9]+]]:gpr(i8) = G_ADD [[COPY]], [[COPY1]]
    ; FAST-NEXT: $al = COPY [[ADD]](i8)
    ; FAST-NEXT: RET 0, implicit $al
    ;
    ; GREEDY-LABEL: name: test_add_i8
    ; GREEDY: liveins: $edi, $esi
    ; GREEDY-NEXT: {{  $}}
    ; GREEDY-NEXT: [[COPY:%[0-9]+]]:gpr(i8) = COPY $dil
    ; GREEDY-NEXT: [[COPY1:%[0-9]+]]:gpr(i8) = COPY $sil
    ; GREEDY-NEXT: [[ADD:%[0-9]+]]:gpr(i8) = G_ADD [[COPY]], [[COPY1]]
    ; GREEDY-NEXT: $al = COPY [[ADD]](i8)
    ; GREEDY-NEXT: RET 0, implicit $al
    %0(i8) = COPY $dil
    %1(i8) = COPY $sil
    %2(i8) = G_ADD %0, %1
    $al = COPY %2(i8)
    RET 0, implicit $al

