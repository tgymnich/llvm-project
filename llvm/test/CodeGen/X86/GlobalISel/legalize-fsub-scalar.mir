# RUN: llc -mtriple=x86_64-linux-gnu -run-pass=legalizer %s -o - | FileCheck %s
--- |

  define float @test_fsub_float(float %arg1, float %arg2) {
    %ret = fsub float %arg1, %arg2
    ret float %ret
  }

  define double @test_fsub_double(double %arg1, double %arg2) {
    %ret = fsub double %arg1, %arg2
    ret double %ret
  }

...
---
name:            test_fsub_float
alignment:       16
legalized:       false
regBankSelected: false
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
  - { id: 2, class: _, preferred-register: '' }
  - { id: 3, class: _, preferred-register: '' }
  - { id: 4, class: _, preferred-register: '' }
  - { id: 5, class: _, preferred-register: '' }
liveins:
fixedStack:
stack:
constants:
body:             |
  bb.1 (%ir-block.0):
    liveins: $xmm0, $xmm1

    ; CHECK-LABEL: name: test_fsub_float
    ; CHECK: liveins: $xmm0, $xmm1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i128) = COPY $xmm0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(f32) = G_TRUNC [[COPY]](i128)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i128) = COPY $xmm1
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(f32) = G_TRUNC [[COPY1]](i128)
    ; CHECK-NEXT: [[FSUB:%[0-9]+]]:_(f32) = G_FSUB [[TRUNC]], [[TRUNC1]]
    ; CHECK-NEXT: [[ANYEXT:%[0-9]+]]:_(i128) = G_ANYEXT [[FSUB]](f32)
    ; CHECK-NEXT: $xmm0 = COPY [[ANYEXT]](i128)
    ; CHECK-NEXT: RET 0, implicit $xmm0
    %2:_(i128) = COPY $xmm0
    %0:_(f32) = G_TRUNC %2(i128)
    %3:_(i128) = COPY $xmm1
    %1:_(f32) = G_TRUNC %3(i128)
    %4:_(f32) = G_FSUB %0, %1
    %5:_(i128) = G_ANYEXT %4(f32)
    $xmm0 = COPY %5(i128)
    RET 0, implicit $xmm0

...
