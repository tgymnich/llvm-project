---
name:            fcmp_float_oeq
alignment:       16
tracksRegLiveness: true
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
  - { id: 2, class: _ }
  - { id: 3, class: _ }
  - { id: 4, class: _ }
  - { id: 5, class: _ }
body:             |
  bb.1 (%ir-block.0):
    liveins: $xmm0, $xmm1

    ; CHECK-LABEL: name: fcmp_float_oeq
    ; CHECK: liveins: $xmm0, $xmm1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i128) = COPY $xmm0
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(f32) = G_TRUNC [[COPY]](i128)
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:_(i128) = COPY $xmm1
    ; CHECK-NEXT: [[TRUNC1:%[0-9]+]]:_(f32) = G_TRUNC [[COPY1]](i128)
    ; CHECK-NEXT: [[FCMP:%[0-9]+]]:_(i8) = G_FCMP floatpred(oeq), [[TRUNC]](f32), [[TRUNC1]]
    ; CHECK-NEXT: $al = COPY [[FCMP]](i8)
    ; CHECK-NEXT: RET 0, implicit $al
    %2:_(i128) = COPY $xmm0
    %0:_(f32) = G_TRUNC %2(i128)
    %3:_(i128) = COPY $xmm1
    %1:_(f32) = G_TRUNC %3(i128)
    %4:_(i1) = G_FCMP floatpred(oeq), %0(f32), %1
    %5:_(i8) = G_ANYEXT %4(i1)
    $al = COPY %5(i8)
    RET 0, implicit $al

...
