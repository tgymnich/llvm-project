# test bswap for s16, s32, and s64

---
name:            test_bswap64
body:             |
  bb.1:
    ; X86-32-LABEL: name: test_bswap64
    ; X86-32: [[DEF:%[0-9]+]]:_(i64) = IMPLICIT_DEF
    ; X86-32-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[DEF]](i64)
    ; X86-32-NEXT: [[BSWAP:%[0-9]+]]:_(i32) = G_BSWAP [[UV1]]
    ; X86-32-NEXT: [[BSWAP1:%[0-9]+]]:_(i32) = G_BSWAP [[UV]]
    ; X86-32-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES [[BSWAP]](i32), [[BSWAP1]](i32)
    ; X86-32-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY [[MV]](i64)
    ; X86-32-NEXT: RET 0, implicit [[COPY]](i64)
    ;
    ; X86-64-LABEL: name: test_bswap64
    ; X86-64: [[DEF:%[0-9]+]]:_(i64) = IMPLICIT_DEF
    ; X86-64-NEXT: [[BSWAP:%[0-9]+]]:_(i64) = G_BSWAP [[DEF]]
    ; X86-64-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY [[BSWAP]](i64)
    ; X86-64-NEXT: RET 0, implicit [[COPY]](i64)
    %0:_(i64) = IMPLICIT_DEF
    %1:_(i64) = G_BSWAP %0
    %2:_(i64) = COPY %1(i64)
    RET 0, implicit %2

...
