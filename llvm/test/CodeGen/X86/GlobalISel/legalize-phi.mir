body:             |
  ; CHECK-LABEL: name: test_i1
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x40000000), %bb.1(0x40000000)
  ; CHECK-NEXT:   liveins: $edi, $edx, $esi
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:_(i32) = COPY $edi
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:_(i32) = COPY $esi
  ; CHECK-NEXT:   [[TRUNC:%[0-9]+]]:_(i1) = G_TRUNC [[COPY1]](i32)
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:_(i32) = COPY $edx
  ; CHECK-NEXT:   [[TRUNC1:%[0-9]+]]:_(i1) = G_TRUNC [[COPY2]](i32)
  ; CHECK-NEXT:   [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
  ; CHECK-NEXT:   [[ICMP:%[0-9]+]]:_(i8) = G_ICMP intpred(sgt), [[COPY]](i32), [[C]]
  ; CHECK-NEXT:   [[TRUNC2:%[0-9]+]]:_(i1) = G_TRUNC [[ICMP]](i8)
  ; CHECK-NEXT:   G_BRCOND [[TRUNC2]](i1), %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.cond.false:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.cond.end:
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:_(i1) = G_PHI [[TRUNC1]](i1), %bb.1, [[TRUNC]](i1), %bb.0
  ; CHECK-NEXT:   [[ANYEXT:%[0-9]+]]:_(i8) = G_ANYEXT [[PHI]](i1)
  ; CHECK-NEXT:   $al = COPY [[ANYEXT]](i8)
  ; CHECK-NEXT:   RET 0, implicit $al
  bb.1.entry:
    successors: %bb.3(0x40000000), %bb.2(0x40000000)
    liveins: $edi, $edx, $esi

    %0:_(i32) = COPY $edi
    %3:_(i32) = COPY $esi
    %1:_(i1) = G_TRUNC %3(i32)
    %4:_(i32) = COPY $edx
    %2:_(i1) = G_TRUNC %4(i32)
    %5:_(i32) = G_CONSTANT i32 0
    %6:_(i1) = G_ICMP intpred(sgt), %0(i32), %5
    G_BRCOND %6(i1), %bb.3

  bb.2.cond.false:
    successors: %bb.3(0x80000000)


  bb.3.cond.end:
    %7:_(i1) = G_PHI %2(i1), %bb.2, %1(i1), %bb.1
    %8:_(i8) = G_ANYEXT %7(i1)
    $al = COPY %8(i8)
    RET 0, implicit $al

...
