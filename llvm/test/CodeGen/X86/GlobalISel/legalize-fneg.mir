# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -O0 -run-pass=legalizer %s -o - | FileCheck %s

--- |
  target triple = "x86_64--"
  define void @test_fneg_f32() {
  entry:
    ret void
  }
  define void @test_fneg_f64() {
  entry:
    ret void
  }
...
---
name:            test_fneg_f32
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
body:             |
  bb.1:
    liveins:
    ; CHECK-LABEL: name: test_fneg_f32
    ; CHECK: [[DEF:%[0-9]+]]:_(f32) = IMPLICIT_DEF
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i32) = G_BITCAST [[DEF]](f32)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 -2147483648
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i32) = G_XOR [[BITCAST]], [[C]]
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(f32) = G_BITCAST [[XOR]](i32)
    ; CHECK-NEXT: $edi = COPY [[BITCAST1]](f32)
    %0(f32) = IMPLICIT_DEF
    %1(f32) = G_FNEG %0
    $edi = COPY %1
...
---
name:            test_fneg_f64
registers:
  - { id: 0, class: _ }
  - { id: 1, class: _ }
body:             |
  bb.1:
    liveins:
    ; CHECK-LABEL: name: test_fneg_f64
    ; CHECK: [[DEF:%[0-9]+]]:_(f64) = G_IMPLICIT_DEF
    ; CHECK-NEXT: [[BITCAST:%[0-9]+]]:_(i64) = G_BITCAST [[DEF]](f64)
    ; CHECK-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 -9223372036854775808
    ; CHECK-NEXT: [[XOR:%[0-9]+]]:_(i64) = G_XOR [[BITCAST]], [[C]]
    ; CHECK-NEXT: [[BITCAST1:%[0-9]+]]:_(f64) = G_BITCAST [[XOR]](i64)
    ; CHECK-NEXT: $rdi = COPY [[BITCAST1]](f64)
    %0(f64) = G_IMPLICIT_DEF
    %1(f64) = G_FNEG %0
    $rdi = COPY %1
...
