# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 2
# RUN: llc -mtriple=x86_64-linux-gnu -mattr=+popcnt -run-pass=legalizer %s -o - | FileCheck %s

# test popcount for s16, s32, and s64

---
name:            test_ctpop35
alignment:       16
legalized:       false
regBankSelected: false
registers:
  - { id: 0, class: _, preferred-register: '' }
  - { id: 1, class: _, preferred-register: '' }
body:             |
  bb.1:
    ; CHECK-LABEL: name: test_ctpop35
    ; CHECK: [[DEF:%[0-9]+]]:_(i35) = IMPLICIT_DEF
    ; CHECK-NEXT: [[ZEXT:%[0-9]+]]:_(i64) = G_ZEXT [[DEF]](i35)
    ; CHECK-NEXT: [[CTPOP:%[0-9]+]]:_(i64) = G_CTPOP [[ZEXT]](i64)
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(i64) = COPY [[CTPOP]](i64)
    ; CHECK-NEXT: RET 0, implicit [[COPY]](i64)
    %0:_(i35) = IMPLICIT_DEF
    %1:_(i35) = G_CTPOP %0
    %2:_(i64) = G_ZEXT %1
    %3:_(i64) = COPY %2(i64)
    RET 0, implicit %3

...
