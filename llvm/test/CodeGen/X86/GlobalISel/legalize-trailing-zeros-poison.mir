# RUN: llc -mtriple=x86_64-linux-gnu -run-pass=legalizer %s -o - | FileCheck %s --check-prefixes=CHECK,X64
# RUN: llc -mtriple=i386-linux-gnu -run-pass=legalizer %s -o - | FileCheck %s --check-prefixes=CHECK,X86

# test count trailing zeros for s16, s32, and s64

---
name:            test_cttz35
alignment:       16
legalized:       false
regBankSelected: false
registers:
  - { id: 0, class: _, preferred-register: '' }
body:             |
  bb.1:
    ; X64-LABEL: name: test_cttz35
    ; X64: [[COPY:%[0-9]+]]:_(i64) = COPY $rdx
    ; X64-NEXT: [[C:%[0-9]+]]:_(i64) = G_CONSTANT i64 34359738368
    ; X64-NEXT: [[OR:%[0-9]+]]:_(i64) = G_OR [[COPY]], [[C]]
    ; X64-NEXT: [[CTTZ_ZERO_POISON:%[0-9]+]]:_(i64) = G_CTTZ_ZERO_POISON [[OR]](i64)
    ; X64-NEXT: RET 0, implicit [[CTTZ_ZERO_POISON]](i64)
    ;
    ; X86-LABEL: name: test_cttz35
    ; X86: [[COPY:%[0-9]+]]:_(i64) = COPY $rdx
    ; X86-NEXT: [[C:%[0-9]+]]:_(i32) = G_CONSTANT i32 0
    ; X86-NEXT: [[C1:%[0-9]+]]:_(i32) = G_CONSTANT i32 8
    ; X86-NEXT: [[UV:%[0-9]+]]:_(i32), [[UV1:%[0-9]+]]:_(i32) = G_UNMERGE_VALUES [[COPY]](i64)
    ; X86-NEXT: [[OR:%[0-9]+]]:_(i32) = G_OR [[UV]], [[C]]
    ; X86-NEXT: [[OR1:%[0-9]+]]:_(i32) = G_OR [[UV1]], [[C1]]
    ; X86-NEXT: [[ICMP:%[0-9]+]]:_(i8) = G_ICMP intpred(eq), [[OR]](i32), [[C]]
    ; X86-NEXT: [[CTTZ_ZERO_POISON:%[0-9]+]]:_(i32) = G_CTTZ_ZERO_POISON [[OR1]](i32)
    ; X86-NEXT: [[C2:%[0-9]+]]:_(i32) = G_CONSTANT i32 32
    ; X86-NEXT: [[UADDO:%[0-9]+]]:_(i32), [[UADDO1:%[0-9]+]]:_(i8) = G_UADDO [[CTTZ_ZERO_POISON]], [[C2]]
    ; X86-NEXT: [[UADDE:%[0-9]+]]:_(i32), [[UADDE1:%[0-9]+]]:_(i8) = G_UADDE [[C]], [[C]], [[UADDO1]]
    ; X86-NEXT: [[CTTZ_ZERO_POISON1:%[0-9]+]]:_(i32) = G_CTTZ_ZERO_POISON [[OR]](i32)
    ; X86-NEXT: [[ANYEXT:%[0-9]+]]:_(i32) = G_ANYEXT [[ICMP]](i8)
    ; X86-NEXT: [[C3:%[0-9]+]]:_(i32) = G_CONSTANT i32 1
    ; X86-NEXT: [[AND:%[0-9]+]]:_(i32) = G_AND [[ANYEXT]], [[C3]]
    ; X86-NEXT: [[SELECT:%[0-9]+]]:_(i32) = G_SELECT [[AND]](i32), [[UADDO]], [[CTTZ_ZERO_POISON1]]
    ; X86-NEXT: [[SELECT1:%[0-9]+]]:_(i32) = G_SELECT [[AND]](i32), [[UADDE]], [[C]]
    ; X86-NEXT: [[MV:%[0-9]+]]:_(i64) = G_MERGE_VALUES [[SELECT]](i32), [[SELECT1]](i32)
    ; X86-NEXT: RET 0, implicit [[MV]](i64)
    %0(i64) = COPY $rdx
    %1:_(i35) = G_TRUNC %0(i64)
    %2:_(i35) = G_CTTZ %1
    %3:_(i64) = G_ZEXT %2
    RET 0, implicit %3
...
