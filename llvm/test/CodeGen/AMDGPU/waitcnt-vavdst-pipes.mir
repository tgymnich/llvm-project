    ; CHECK: S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; CHECK-NEXT: S_WAIT_KMCNT 0
    ; CHECK-NEXT: $vgpr30 = V_MOV_B32_e32 $vgpr95, implicit $exec
    ; CHECK-NEXT: early-clobber $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 8, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 0, 0, 0, 0, implicit $exec
    ; CHECK-NEXT: $exec_lo = S_MOV_B32 $sgpr8
    ; CHECK-NEXT: $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_WAITCNT_DEPCTR .VaVdst_1
    ; CHECK-NEXT: DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr30 = V_MOV_B32_e32 $vgpr95, implicit $exec
    $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23 = V_WMMA_F32_16X16X32_BF16_w32_twoaddr $vgpr0_vgpr1_vgpr2_vgpr3_vgpr4_vgpr5_vgpr6_vgpr7, $vgpr8_vgpr9_vgpr10_vgpr11_vgpr12_vgpr13_vgpr14_vgpr15, 8, $vgpr16_vgpr17_vgpr18_vgpr19_vgpr20_vgpr21_vgpr22_vgpr23, 0, 0, 0, 0, implicit $exec
    $exec_lo = S_MOV_B32 $sgpr8
    $vgpr33 = V_ADD_F32_e32 $vgpr94, $vgpr95, implicit $mode, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    S_ENDPGM 0
...

---
# A stale access must not be left behind when EXEC is written again.
name: exec_write_in_loop
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: exec_write_in_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; CHECK-NEXT:   S_WAIT_KMCNT 0
  ; CHECK-NEXT:   V_CMPX_EQ_U32_nosdst_e32 $vgpr64, $vgpr61, implicit-def $exec, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_0
  ; CHECK-NEXT:   $vgpr32 = DS_READ_B32_gfx9 $vgpr62, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_WAIT_DSCNT 0
  ; CHECK-NEXT:   $vgpr32 = V_ADD_U32_e32 $vgpr60, $vgpr24, implicit $exec
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 killed $sgpr8
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1
    V_CMPX_EQ_U32_nosdst_e32 $vgpr64, $vgpr61, implicit-def $exec, implicit $exec
  bb.1:
    successors: %bb.1, %bb.2
    $vgpr32 = DS_READ_B32_gfx9 $vgpr62, 0, 0, implicit $exec
    $vgpr32 = V_ADD_U32_e32 $vgpr60, $vgpr24, implicit $exec
    $exec_lo = S_MOV_B32 killed $sgpr8
    S_CBRANCH_SCC1 %bb.1, implicit undef $scc
  bb.2:
    S_ENDPGM 0
...
