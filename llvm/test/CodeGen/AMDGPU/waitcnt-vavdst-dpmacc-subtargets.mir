    ; CHECK-NEXT: $vgpr44_vgpr45 = V_ADD_F64_pseudo_e64 0, $vgpr80_vgpr81, 0, $vgpr82_vgpr83, 0, 0, implicit $mode, implicit $exec
    ; GFX1200-GFX1310-NEXT: S_WAITCNT_DEPCTR .VaVdst_1
