# RUN: llc -mtriple=amdgpu12.00 -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefixes=CHECK,GFX1200-GFX1310
# RUN: llc -mtriple=amdgpu13.10 -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefixes=CHECK,GFX1200-GFX1310
# RUN: llc -mtriple=amdgpu12.50 -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefixes=CHECK,GFX1250
# RUN: llc -mtriple=amdgpu12.50s -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefixes=CHECK,GFX1250
# RUN: llc -mtriple=amdgpu12.51 -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefixes=CHECK,GFX1251
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx12-5-generic -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s --check-prefixes=CHECK,GENERIC

---
name: mul_lo_before_dp
tracksRegLiveness: false
body: |
  bb.0:
    ; CHECK-LABEL: name: mul_lo_before_dp
    ; CHECK: $vgpr20 = V_MUL_LO_U32_e64 $vgpr80, $vgpr81, implicit $exec
    ; CHECK-NEXT: $vgpr44_vgpr45 = V_ADD_F64_pseudo_e64 0, $vgpr80_vgpr81, 0, $vgpr82_vgpr83, 0, 0, implicit $mode, implicit $exec
    ; GFX1200-GFX1310-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; GFX1250-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; GFX1251-NEXT: S_WAITCNT_DEPCTR .VaVdst_1
    ; GENERIC-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; CHECK-NEXT: DS_WRITE_B32_gfx9 $vgpr64, $vgpr20, 0, 0, implicit $exec
    $vgpr20 = V_MUL_LO_U32_e64 $vgpr80, $vgpr81, implicit $exec
    $vgpr44_vgpr45 = V_ADD_F64_pseudo_e64 0, $vgpr80_vgpr81, 0, $vgpr82_vgpr83, 0, 0, implicit $mode, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr64, $vgpr20, 0, 0, implicit $exec
    S_ENDPGM 0
...

