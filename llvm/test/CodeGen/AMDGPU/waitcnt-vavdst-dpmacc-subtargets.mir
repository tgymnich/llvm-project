    ; CHECK-NEXT: $vgpr60 = V_MOV_B32_e32 $vgpr61, implicit $exec
    ; GFX1200-GFX1310-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; GFX1250-NEXT: S_WAITCNT_DEPCTR .VaVdst_1
    ; GFX1251-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; GENERIC-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; CHECK-NEXT: $vgpr0_vgpr1 = DS_READ_B64_gfx9 $vgpr90, 0, 0, implicit $exec
    $sgpr0 = V_CMP_EQ_F64_e64 0, $vgpr0_vgpr1, 0, $vgpr2_vgpr3, 0, implicit $mode, implicit $exec
    $vgpr60 = V_MOV_B32_e32 $vgpr61, implicit $exec
    $vgpr0_vgpr1 = DS_READ_B64_gfx9 $vgpr90, 0, 0, implicit $exec
    S_ENDPGM 0
...

