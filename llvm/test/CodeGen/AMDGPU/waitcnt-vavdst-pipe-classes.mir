# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgpu12.50 -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu12.50s -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu12.51 -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx12-5-generic -amdgpu-expert-scheduling-mode -run-pass=si-insert-waitcnts %s -o - | FileCheck %s

# Each function issues one write, then the instructions under test, then reads
# the write. The wait is the number of instructions that complete on the same
# pipe as the write.
---
name: f64_trans_after_dp_write
tracksRegLiveness: false
body: |
  bb.0:
    ; CHECK-LABEL: name: f64_trans_after_dp_write
    ; CHECK: S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
    ; CHECK-NEXT: S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
    ; CHECK-NEXT: S_WAIT_KMCNT 0
    ; CHECK-NEXT: $vgpr30_vgpr31 = V_ADD_F64_pseudo_e64 0, $vgpr90_vgpr91, 0, $vgpr92_vgpr93, 0, 0, implicit $mode, implicit $exec
    ; CHECK-NEXT: $vgpr32_vgpr33 = V_SQRT_F64_e32 $vgpr90_vgpr91, implicit $mode, implicit $exec
    ; CHECK-NEXT: S_WAITCNT_DEPCTR .VaVdst_0
    ; CHECK-NEXT: DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    ; CHECK-NEXT: S_ENDPGM 0
    $vgpr30_vgpr31 = V_ADD_F64_pseudo_e64 0, $vgpr90_vgpr91, 0, $vgpr92_vgpr93, 0, 0, implicit $mode, implicit $exec
    $vgpr32_vgpr33 = V_SQRT_F64_e32 $vgpr90_vgpr91, implicit $mode, implicit $exec
    DS_WRITE_B32_gfx9 $vgpr96, $vgpr30, 0, 0, implicit $exec
    S_ENDPGM 0
...

