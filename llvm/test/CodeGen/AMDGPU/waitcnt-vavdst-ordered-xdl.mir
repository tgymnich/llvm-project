name: joined_writelane_and_predicated_dot
tracksRegLiveness: false
body: |
  ; CHECK-LABEL: name: joined_writelane_and_predicated_dot
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   S_SETREG_IMM32_B32 2, 2074, implicit-def $mode, implicit $mode
  ; CHECK-NEXT:   S_WAIT_LOADCNT_DSCNT .Loadcnt_0_Dscnt_0
  ; CHECK-NEXT:   S_WAIT_KMCNT 0
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 0
  ; CHECK-NEXT:   S_CBRANCH_SCC1 %bb.2, implicit $scc
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr40 = V_WRITELANE_B32 $sgpr4, 0, $vgpr40
  ; CHECK-NEXT:   S_BRANCH %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $vgpr40 = V_DOT4_I32_IU8 8, $vgpr28, 8, $vgpr29, 8, $vgpr40, 0, 0, 0, implicit $exec
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   $vgpr40 = V_DOT4_I32_IU8 8, $vgpr28, 8, $vgpr29, 8, $vgpr40, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   $vgpr33 = V_DOT4_I32_IU8 8, $vgpr28, 8, $vgpr29, 8, $vgpr33, 0, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_1
  ; CHECK-NEXT:   $exec_lo = S_MOV_B32 -1
  ; CHECK-NEXT:   S_WAITCNT_DEPCTR .VaVdst_0
  ; CHECK-NEXT:   DS_WRITE_B32_gfx9 $vgpr64, $vgpr40, 0, 0, implicit $exec
  ; CHECK-NEXT:   S_ENDPGM 0
  bb.0:
    successors: %bb.1, %bb.2
    $exec_lo = S_MOV_B32 0
    S_CBRANCH_SCC1 %bb.2, implicit $scc

  bb.1:
    successors: %bb.3
    $vgpr40 = V_WRITELANE_B32 $sgpr4, 0, $vgpr40
    S_BRANCH %bb.3

  bb.2:
    successors: %bb.3
    $vgpr40 = V_DOT4_I32_IU8 8, $vgpr28, 8, $vgpr29, 8, $vgpr40, 0, 0, 0, implicit $exec

  bb.3:
    $vgpr40 = V_DOT4_I32_IU8 8, $vgpr28, 8, $vgpr29, 8, $vgpr40, 0, 0, 0, implicit $exec
    $vgpr33 = V_DOT4_I32_IU8 8, $vgpr28, 8, $vgpr29, 8, $vgpr33, 0, 0, 0, implicit $exec
    S_WAITCNT_DEPCTR .VaVdst_1
    $exec_lo = S_MOV_B32 -1
    DS_WRITE_B32_gfx9 $vgpr64, $vgpr40, 0, 0, implicit $exec
    S_ENDPGM 0
...

