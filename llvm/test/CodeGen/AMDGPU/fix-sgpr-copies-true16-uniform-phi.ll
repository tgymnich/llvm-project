; RUN: llc -mtriple=amdgpu12.50-amd-amdhsa < %s | FileCheck %s

; Single-lane execution makes the half PHI uniform, so it is selected as an SGPR
; PHI of the loaded VGPR's low half. Moving it to the VALU must keep the load.

define amdgpu_kernel void @uniform_f16_phi_of_vgpr_load(ptr addrspace(1) %in, ptr addrspace(1) %out, i32 %idx, i1 %c) #0 {
; CHECK-LABEL: uniform_f16_phi_of_vgpr_load:
; CHECK:       ; %bb.0: ; %entry
; CHECK-NEXT:    s_setreg_imm32_b32 hwreg(HW_REG_WAVE_MODE, 25, 1), 1 ; msbs: dst=0 src0=0 src1=0 src2=0
; CHECK-NEXT:    s_mov_b64 s[64:65], 0
; CHECK-NEXT:    v_nop
; CHECK-NEXT:    global_prefetch_b8 v0, s[64:65] scope:SCOPE_SE
; CHECK-NEXT:    s_clause 0x1
; CHECK-NEXT:    s_load_b64 s[6:7], s[4:5], 0x10 nv
; CHECK-NEXT:    s_load_b128 s[0:3], s[4:5], 0x0 nv
; CHECK-NEXT:    v_dual_mov_b32 v0, 0 :: v_dual_mov_b32 v1, 0xfbff
; CHECK-NEXT:    v_mov_b16_e32 v2.l, 0
; CHECK-NEXT:    s_wait_kmcnt 0x0
; CHECK-NEXT:    s_bitcmp0_b32 s7, 0
; CHECK-NEXT:    global_store_b16 v0, v2, s[2:3]
; CHECK-NEXT:    s_cbranch_scc1 .LBB0_2
; CHECK-NEXT:  ; %bb.1: ; %load
; CHECK-NEXT:    v_mov_b32_e32 v1, s6
; CHECK-NEXT:    global_load_u16 v1, v1, s[0:1] scale_offset
; CHECK-NEXT:  .LBB0_2: ; %join
; CHECK-NEXT:    s_wait_loadcnt 0x0
; CHECK-NEXT:    s_wait_xcnt 0x0
; CHECK-NEXT:    v_max_num_f16_e32 v1.l, 1.0, v1.l
; CHECK-NEXT:    global_store_b16 v0, v1, s[2:3]
; CHECK-NEXT:    s_endpgm
entry:
  store half 0xH0000, ptr addrspace(1) %out
  br i1 %c, label %load, label %join

load:
  %gep = getelementptr half, ptr addrspace(1) %in, i32 %idx
  %v = load half, ptr addrspace(1) %gep
  br label %join

join:
  %phi = phi half [ %v, %load ], [ 0xHFBFF, %entry ]
  %max = call half @llvm.maxnum.f16(half %phi, half 1.0)
  store half %max, ptr addrspace(1) %out
  ret void
}

attributes #0 = { "amdgpu-flat-work-group-size"="1,1" "amdgpu-no-wwm" }
