# RUN: llc -mtriple=amdgpu12.00 -mattr=-real-true16 -run-pass=amdgpu-regbank-combiner -verify-machineinstrs %s -o - | FileCheck %s

---
name: sextload_i8_hi
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: sextload_i8_hi
    ; CHECK: G_AMDGPU_LOAD_D16_HI_I8 %ptr(p0), %vec :: (load (i8))
    %vec:vgpr(<2 x i16>) = COPY $vgpr0
    %ptr:vgpr(p0) = COPY $vgpr1_vgpr2
    %load:vgpr(i32) = G_SEXTLOAD %ptr :: (load (i8))
    %bits:vgpr(i32) = G_BITCAST %vec
    %mask:sgpr(i32) = G_CONSTANT i32 65535
    %mask_v:vgpr(i32) = COPY %mask
    %preserved:vgpr(i32) = G_AND %bits, %mask_v
    %amount:sgpr(i32) = G_CONSTANT i32 16
    %amount_v:vgpr(i32) = COPY %amount
    %shifted:vgpr(i32) = G_SHL %load, %amount_v
    %merged:vgpr(i32) = G_OR %preserved, %shifted
    %res:vgpr(<2 x i16>) = G_BITCAST %merged
    $vgpr0 = COPY %res
    S_ENDPGM 0
...
---
name: sextload_i16_hi
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: sextload_i16_hi
    ; CHECK-NOT: G_AMDGPU_LOAD_D16
    ; CHECK: %load:vgpr(i32) = G_SEXTLOAD %ptr(p0) :: (load (i16))
    ; CHECK: %res:vgpr(<2 x i16>) = G_BITCAST %merged(i32)
    %vec:vgpr(<2 x i16>) = COPY $vgpr0
    %ptr:vgpr(p0) = COPY $vgpr1_vgpr2
    %load:vgpr(i32) = G_SEXTLOAD %ptr :: (load (i16))
    %bits:vgpr(i32) = G_BITCAST %vec
    %mask:sgpr(i32) = G_CONSTANT i32 65535
    %mask_v:vgpr(i32) = COPY %mask
    %preserved:vgpr(i32) = G_AND %bits, %mask_v
    %amount:sgpr(i32) = G_CONSTANT i32 16
    %amount_v:vgpr(i32) = COPY %amount
    %shifted:vgpr(i32) = G_SHL %load, %amount_v
    %merged:vgpr(i32) = G_OR %preserved, %shifted
    %res:vgpr(<2 x i16>) = G_BITCAST %merged
    $vgpr0 = COPY %res
    S_ENDPGM 0
...
---
name: sextload_i8_lo
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1_vgpr2
    ; CHECK-LABEL: name: sextload_i8_lo
    ; CHECK-NOT: G_AMDGPU_LOAD_D16
    ; CHECK: %load:vgpr(i32) = G_SEXTLOAD %ptr(p0) :: (load (i8))
    ; CHECK: %res:vgpr(<2 x i16>) = G_BITCAST %merged(i32)
    %vec:vgpr(<2 x i16>) = COPY $vgpr0
    %ptr:vgpr(p0) = COPY $vgpr1_vgpr2
    %load:vgpr(i32) = G_SEXTLOAD %ptr :: (load (i8))
    %bits:vgpr(i32) = G_BITCAST %vec
    %mask:sgpr(i32) = G_CONSTANT i32 -65536
    %mask_v:vgpr(i32) = COPY %mask
    %preserved:vgpr(i32) = G_AND %bits, %mask_v
    %merged:vgpr(i32) = G_OR %preserved, %load
    %res:vgpr(<2 x i16>) = G_BITCAST %merged
    $vgpr0 = COPY %res
    S_ENDPGM 0
...
