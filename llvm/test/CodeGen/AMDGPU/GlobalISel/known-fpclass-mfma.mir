# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx950 -passes="print<gisel-value-tracking-fpclass>" %s -filetype=null 2>&1 | FileCheck %s

---
name: finite_32x32x4f16
body: |
  bb.0:
    ; CHECK-LABEL: name: @finite_32x32x4f16
    ; CHECK: %d:_ FPClasses:(zero sub norm) SignBitKnown:?
    %a:_(s16) = G_FCONSTANT half 65504.0
    %b:_(s16) = G_FCONSTANT half -65504.0
    %c:_(s32) = G_FCONSTANT float 0.0
    %av:_(<4 x s16>) = G_BUILD_VECTOR %a, %a, %a, %a
    %bv:_(<4 x s16>) = G_BUILD_VECTOR %b, %b, %b, %b
    %cv:_(<32 x s32>) = G_BUILD_VECTOR %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c
    %d:_(<32 x s32>) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.mfma.f32.32x32x4f16), %av, %bv, %cv, 0, 0, 0
...

---
