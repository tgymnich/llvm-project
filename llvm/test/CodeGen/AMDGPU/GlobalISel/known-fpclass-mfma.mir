---
name: nan_a
body: |
  bb.0:
    ; CHECK-LABEL: name: @nan_a
    ; CHECK: %d:_ FPClasses:(all) SignBitKnown:?
    %a:_(s16) = G_FCONSTANT half 0xH7E00
    %b:_(s16) = G_FCONSTANT half 1.0
    %c:_(s32) = G_FCONSTANT float 0.0
    %av:_(<4 x s16>) = G_BUILD_VECTOR %a, %a, %a, %a
    %bv:_(<4 x s16>) = G_BUILD_VECTOR %b, %b, %b, %b
    %cv:_(<4 x s32>) = G_BUILD_VECTOR %c, %c, %c, %c
    %d:_(<4 x s32>) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.mfma.f32.16x16x16f16), %av, %bv, %cv, 0, 0, 0
...

