    %cv:_(<16 x s32>) = G_BUILD_VECTOR %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c, %c
    %d:_(<16 x s32>) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.mfma.f32.16x16x4f16), %av, %bv, %cv, 0, 0, 0
...

