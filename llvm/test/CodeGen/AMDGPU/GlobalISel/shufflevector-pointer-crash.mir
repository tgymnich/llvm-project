# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=amdgpu6.00 -run-pass=legalizer %s -o - | FileCheck %s

---
name:            test
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: test
    ; CHECK: [[C:%[0-9]+]]:_(p0) = G_CONSTANT i64 0
    ; CHECK-NEXT: [[LOAD:%[0-9]+]]:_(i32) = G_LOAD [[C]](p0) :: (load (i32), align 16)
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(p0) = G_CONSTANT i64 4
    ; CHECK-NEXT: [[LOAD1:%[0-9]+]]:_(i32) = G_LOAD [[C1]](p0) :: (load (i32) from unknown-address + 4)
    ; CHECK-NEXT: $vgpr0 = COPY [[LOAD]](i32)
    ; CHECK-NEXT: $vgpr1 = COPY [[LOAD1]](i32)
    ; CHECK-NEXT: SI_RETURN implicit $vgpr0, implicit $vgpr1
    %0:_(p0) = G_CONSTANT i64 0
    %1:_(<2 x p0>) = G_BUILD_VECTOR %0:_(p0), %0:_(p0)
    %2:_(<2 x p0>) = G_LOAD %0:_(p0) :: (load (<2 x p0>))
    %idx:_(s32) = G_CONSTANT i32 0
    %3:_(p0) = G_EXTRACT_VECTOR_ELT %2:_(<2 x p0>), %idx
    %4:_(s32), %5:_(s32) = G_UNMERGE_VALUES %3:_(p0)
    $vgpr0 = COPY %4:_(s32)
    $vgpr1 = COPY %5:_(s32)
    SI_RETURN implicit $vgpr0, implicit $vgpr1
...

