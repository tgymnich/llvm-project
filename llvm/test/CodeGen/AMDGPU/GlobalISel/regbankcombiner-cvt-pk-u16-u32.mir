---
name: build_vector_trunc
legalized: true
regBankSelected: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1

    ; CHECK-LABEL: name: build_vector_trunc
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:vgpr(i32) = COPY $vgpr0
    ; CHECK-NEXT: [[COPY1:%[0-9]+]]:vgpr(i32) = COPY $vgpr1
    ; CHECK-NEXT: [[INT:%[0-9]+]]:vgpr(<2 x i16>) = G_INTRINSIC intrinsic(@llvm.amdgcn.cvt.pk.u16), [[COPY]](i32), [[COPY1]](i32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[INT]](<2 x i16>)
    %0:vgpr(i32) = COPY $vgpr0
    %1:vgpr(i32) = COPY $vgpr1
    %3:vgpr(i32) = G_CONSTANT i32 65535
    %4:vgpr(i32) = G_UMIN %0, %3
    %5:vgpr(i32) = G_UMIN %3, %1
    %2:vgpr(<2 x i16>) = G_BUILD_VECTOR_TRUNC %4(i32), %5(i32)
    S_ENDPGM 0, implicit %2
...

