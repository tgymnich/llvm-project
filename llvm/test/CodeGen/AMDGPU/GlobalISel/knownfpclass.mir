# NOTE: Assertions have been autogenerated by utils/update_givaluetracking_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -passes="print<gisel-known-fpclass>" -filetype=null %s 2>&1 | FileCheck %s

---
name:            constants
body:             |
  bb.0:
  ; CHECK-LABEL: name: @constants
  ; CHECK-NEXT: %0:_ KnownFPClasses:(pnorm) SignBit:0
  ; CHECK-NEXT: %1:_ KnownFPClasses:(nnorm) SignBit:1
  ; CHECK-NEXT: %2:_ KnownFPClasses:(pzero) SignBit:0
  ; CHECK-NEXT: %3:_ KnownFPClasses:(nzero) SignBit:1
  ; CHECK-NEXT: %4:_ KnownFPClasses:(qnan) SignBit:0
  ; CHECK-NEXT: %5:_ KnownFPClasses:(nnorm) SignBit:1
    %0:_(s32) = G_FCONSTANT float 1.0
    %1:_(s32) = G_FCONSTANT float -1.0
    %2:_(s32) = G_FCONSTANT float 0.0
    %3:_(s32) = G_FCONSTANT float -0.0
    %4:_(s64) = G_FCONSTANT double 0x7FF8000000000000
    %5:_(s32) = COPY %1
...
---
name:            fabs_fneg_copysign
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

  ; CHECK-LABEL: name: @fabs_fneg_copysign
  ; CHECK-NEXT: %2:_ KnownFPClasses:(nan pinf pzero psub pnorm) SignBit:0
  ; CHECK-NEXT: %3:_ KnownFPClasses:(nan ninf nzero nsub nnorm) SignBit:1
  ; CHECK-NEXT: %5:_ KnownFPClasses:(nan pinf pzero psub pnorm) SignBit:0
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_FABS %0
    %3:_(s32) = G_FNEG %2
    %4:_(s32) = G_FNEG %0
    %5:_(s32) = G_FCOPYSIGN %0, %2
...
---
name:            fadd_flags
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

  ; CHECK-LABEL: name: @fadd_flags
  ; CHECK-NEXT: %3:_ KnownFPClasses:(inf zero sub norm) SignBit:unknown
  ; CHECK-NEXT: %4:_ KnownFPClasses:(nan zero sub norm) SignBit:unknown
  ; CHECK-NEXT: %5:_ KnownFPClasses:(zero sub norm) SignBit:unknown
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_FADD %0, %1
    %3:_(s32) = nnan G_FADD %0, %1
    %4:_(s32) = ninf G_FADD %0, %1
    %5:_(s32) = nnan ninf G_FADD %0, %1
...
---
name:            fsqrt_fminnum_fmaxnum
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

  ; CHECK-LABEL: name: @fsqrt_fminnum_fmaxnum
  ; CHECK-NEXT: %2:_ KnownFPClasses:(nan pinf pzero psub pnorm) SignBit:0
  ; CHECK-NEXT: %3:_ KnownFPClasses:(nan pinf pzero pnorm) SignBit:unknown
  ; CHECK-NEXT: %4:_ KnownFPClasses:(pzero) SignBit:0
  ; CHECK-NEXT: %5:_ KnownFPClasses:(pinf zero psub pnorm) SignBit:unknown
  ; CHECK-NEXT: %6:_ KnownFPClasses:(ninf zero nsub nnorm) SignBit:unknown
    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_FABS %0
    %3:_(s32) = G_FSQRT %2
    %4:_(s32) = G_FCONSTANT float 0.0
    %5:_(s32) = G_FMAXNUM %0, %4
    %6:_(s32) = G_FMINNUM %0, %4
...
---
name:            phi
tracksRegLiveness: true
body:             |
  ; CHECK-LABEL: name: @phi
  ; CHECK-NEXT: %2:_ KnownFPClasses:(nan pinf pzero psub pnorm) SignBit:0
  ; CHECK-NEXT: %4:_ KnownFPClasses:(pnorm) SignBit:0
  ; CHECK-NEXT: %5:_ KnownFPClasses:(nan pinf pzero psub pnorm) SignBit:0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $vgpr0, $vgpr1, $sgpr30_sgpr31

    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_FABS %0
    %3:_(s32) = G_FCMP floatpred(ogt), %0(s32), %1
    G_BRCOND %3, %bb.1
    G_BR %bb.2

  bb.1:
    successors: %bb.2

    %4:_(s32) = G_FCONSTANT float 1.0

  bb.2:
    %5:_(s32) = G_PHI %2(s32), %bb.0, %4(s32), %bb.1
    $vgpr0 = COPY %5(s32)
    SI_RETURN implicit $vgpr0
...
