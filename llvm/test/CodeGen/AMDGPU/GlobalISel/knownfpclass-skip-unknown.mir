# RUN: llc -mtriple=amdgcn -mcpu=gfx90a -passes="print<gisel-known-fpclass>" -filetype=null %s 2>&1 | FileCheck %s

# The type system does not tell floating-point apart from integer registers, so
# the printer only emits a line for the defs it inferred something about. Check
# that defs with no known FP class at all are left out entirely.

---
# CHECK-LABEL: name: @unknown_defs
# CHECK-NOT: KnownFPClasses
name:            unknown_defs
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_ADD %0, %1
    %3:_(s32) = G_FADD %0, %1
    %4:_(s32) = G_FMUL %0, %1
...
---
# CHECK-LABEL: name: @some_known_defs
# CHECK-NEXT: %2:_ KnownFPClasses:(nan pinf pzero psub pnorm) SignBit:0
# CHECK-NOT: KnownFPClasses
name:            some_known_defs
body:             |
  bb.0:
    liveins: $vgpr0, $vgpr1

    %0:_(s32) = COPY $vgpr0
    %1:_(s32) = COPY $vgpr1
    %2:_(s32) = G_FABS %0
    %3:_(s32) = G_FADD %0, %1
...
