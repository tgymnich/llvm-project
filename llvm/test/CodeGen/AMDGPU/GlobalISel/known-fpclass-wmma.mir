    %cl:_(s32) = G_FCONSTANT float 0x47DFFFFFE0000000
    %cnl:_(s32) = G_FCONSTANT float 0xC7DFFFFFE0000000
    %av:_(<8 x s16>) = G_BUILD_VECTOR %a, %a, %a, %a, %a, %a, %a, %a
