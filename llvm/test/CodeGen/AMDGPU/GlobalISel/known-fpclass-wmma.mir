# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1100 -passes="print<gisel-value-tracking-fpclass>" %s -filetype=null 2>&1 | FileCheck %s
# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx1200 -passes="print<gisel-value-tracking-fpclass>" %s -filetype=null 2>&1 | FileCheck %s

---
name: wmma_wave32
body: |
  bb.0:
    ; CHECK-LABEL: name: @wmma_wave32
    ; CHECK: %d:_ FPClasses:(zero sub norm) SignBitKnown:?
    %a:_(s16) = G_FCONSTANT half 65504.0
    %b:_(s16) = G_FCONSTANT half -65504.0
    %c:_(s32) = G_FCONSTANT float 0.0
    %av:_(<16 x s16>) = G_BUILD_VECTOR %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a
    %bv:_(<16 x s16>) = G_BUILD_VECTOR %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b
    %cv:_(<8 x s32>) = G_BUILD_VECTOR %c, %c, %c, %c, %c, %c, %c, %c
    %d:_(<8 x s32>) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.wmma.f32.16x16x16.f16), %av, %bv, %cv
...

---
name: wmma_wave64
body: |
  bb.0:
    ; CHECK-LABEL: name: @wmma_wave64
    ; CHECK: %d:_ FPClasses:(zero sub norm) SignBitKnown:?
    %a:_(s16) = G_FCONSTANT half 65504.0
    %b:_(s16) = G_FCONSTANT half -65504.0
    %c:_(s32) = G_FCONSTANT float -0.0
    %av:_(<16 x s16>) = G_BUILD_VECTOR %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a, %a
    %bv:_(<16 x s16>) = G_BUILD_VECTOR %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b, %b
    %cv:_(<4 x s32>) = G_BUILD_VECTOR %c, %c, %c, %c
    %d:_(<4 x s32>) = G_INTRINSIC_CONVERGENT intrinsic(@llvm.amdgcn.wmma.f32.16x16x16.f16), %av, %bv, %cv
...

