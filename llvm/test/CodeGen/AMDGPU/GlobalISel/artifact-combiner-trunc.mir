    %1:_(s64) = G_SEXT %0
    %2:_(s32) = G_TRUNC %1
    %3:_(s128) = G_ZEXT %2
    %4:_(s64) = G_TRUNC %3
    %5:_(s32) = G_TRUNC %4
    $vgpr0 = COPY %5
...

---
name: trunc_merge_f16
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr1
    ; FLOAT-LABEL: name: trunc_merge_f16
    ; FLOAT: liveins: $vgpr0, $vgpr1
    ; FLOAT-NEXT: {{  $}}
    ; FLOAT-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; FLOAT-NEXT: [[FPTRUNC:%[0-9]+]]:_(f16) = G_FPTRUNC [[COPY]](f32)
    ; FLOAT-NEXT: [[FADD:%[0-9]+]]:_(f16) = G_FADD [[FPTRUNC]], [[FPTRUNC]]
    ; FLOAT-NEXT: S_ENDPGM 0, implicit [[FADD]](f16)
    ;
    ; CHECK-LABEL: name: trunc_merge_f16
    ; CHECK: liveins: $vgpr0, $vgpr1
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: [[COPY:%[0-9]+]]:_(f32) = COPY $vgpr0
    ; CHECK-NEXT: [[FPTRUNC:%[0-9]+]]:_(f16) = G_FPTRUNC [[COPY]](f32)
    ; CHECK-NEXT: [[FPEXT:%[0-9]+]]:_(f32) = G_FPEXT [[FPTRUNC]](f16)
    ; CHECK-NEXT: [[FPEXT1:%[0-9]+]]:_(f32) = G_FPEXT [[FPTRUNC]](f16)
    ; CHECK-NEXT: [[FADD:%[0-9]+]]:_(f32) = G_FADD [[FPEXT]], [[FPEXT1]]
    ; CHECK-NEXT: [[FPTRUNC1:%[0-9]+]]:_(f16) = G_FPTRUNC [[FADD]](f32)
    ; CHECK-NEXT: S_ENDPGM 0, implicit [[FPTRUNC1]](f16)
    %0:_(f32) = COPY $vgpr0
    %1:_(f32) = COPY $vgpr1
    %2:_(f16) = G_FPTRUNC %0
    %3:_(f16) = G_FPTRUNC %1
    %4:_(i32) = G_MERGE_VALUES %2, %3
    %5:_(f16) = G_TRUNC %4
    %6:_(f16) = G_FADD %5, %5
    S_ENDPGM 0, implicit %6
...
