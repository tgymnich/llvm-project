# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py
# RUN: llc -mtriple=amdgpu11.00 -mattr=+real-true16 -run-pass=legalizer -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=FLOAT
# RUN: llc -O0 -mtriple=amdgpu6.00-mesa-mesa3d -run-pass=legalizer %s -o - | FileCheck %s

---
name: trunc_s16_merge_s64_s32
tracksRegLiveness: false

body: |
  bb.0:
    ; Test that trunc(merge) with trunc-size < merge-source-size creates a trunc
    ; of the merge source
    ; FLOAT-LABEL: name: trunc_s16_merge_s64_s32
    ; FLOAT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; FLOAT-NEXT: $vgpr0 = COPY [[C]](s32)
    ;
    ; CHECK-LABEL: name: trunc_s16_merge_s64_s32
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY [[C]](s32)
    %0:_(s32) = G_CONSTANT i32 0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s64) = G_MERGE_VALUES %0, %1
    %3:_(s16) = G_TRUNC %2
    %4:_(s32) = G_ANYEXT %3
    $vgpr0 = COPY %4
...

---
name: trunc_s32_merge_s64_s32
tracksRegLiveness: false

body: |
  bb.0:
    ; Test that trunc(merge) with trunc-size == merge-source-size is eliminated
    ; FLOAT-LABEL: name: trunc_s32_merge_s64_s32
    ; FLOAT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; FLOAT-NEXT: $vgpr0 = COPY [[C]](s32)
    ;
    ; CHECK-LABEL: name: trunc_s32_merge_s64_s32
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: $vgpr0 = COPY [[C]](s32)
    %0:_(s32) = G_CONSTANT i32 0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s64) = G_MERGE_VALUES %0, %1
    %3:_(s32) = G_TRUNC %2
    $vgpr0 = COPY %3
...

---
name: trunc_s64_merge_s128_s32
tracksRegLiveness: false

body: |
  bb.0:
    ; Test that trunc(merge) with trunc-size > merge-source-size combines to a
    ; smaller merge
    ; FLOAT-LABEL: name: trunc_s64_merge_s128_s32
    ; FLOAT: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; FLOAT-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; FLOAT-NEXT: [[MV:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[C]](s32), [[C1]](s32)
    ; FLOAT-NEXT: $vgpr0_vgpr1 = COPY [[MV]](s64)
    ;
    ; CHECK-LABEL: name: trunc_s64_merge_s128_s32
    ; CHECK: [[C:%[0-9]+]]:_(s32) = G_CONSTANT i32 0
    ; CHECK-NEXT: [[C1:%[0-9]+]]:_(s32) = G_CONSTANT i32 1
    ; CHECK-NEXT: [[MV:%[0-9]+]]:_(s64) = G_MERGE_VALUES [[C]](s32), [[C1]](s32)
    ; CHECK-NEXT: $vgpr0_vgpr1 = COPY [[MV]](s64)
    %0:_(s32) = G_CONSTANT i32 0
    %1:_(s32) = G_CONSTANT i32 1
    %2:_(s128) = G_MERGE_VALUES %0, %1, %0, %1
    %3:_(s64) = G_TRUNC %2
    $vgpr0_vgpr1 = COPY %3
...

