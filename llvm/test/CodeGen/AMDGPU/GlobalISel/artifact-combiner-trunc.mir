name: trunc_trunc
tracksRegLiveness: false

body: |
  bb.0:
    ; Test that trunc(trunc) is combined to a single trunc
    ; FLOAT-LABEL: name: trunc_trunc
    ; FLOAT: [[COPY:%[0-9]+]]:_(s64) = COPY $sgpr0_sgpr1
    ; FLOAT-NEXT: [[TRUNC:%[0-9]+]]:_(s32) = G_TRUNC [[COPY]](s64)
    ; FLOAT-NEXT: $vgpr0 = COPY [[TRUNC]](s32)
    ;
    ; CHECK-LABEL: name: trunc_trunc
    ; CHECK: [[COPY:%[0-9]+]]:_(s64) = COPY $sgpr0_sgpr1
    ; CHECK-NEXT: [[TRUNC:%[0-9]+]]:_(s32) = G_TRUNC [[COPY]](s64)
    ; CHECK-NEXT: $vgpr0 = COPY [[TRUNC]](s32)
    %0:_(s64) = COPY $sgpr0_sgpr1
    %1:_(s48) = G_TRUNC %0
    %2:_(s32) = G_TRUNC %1
    $vgpr0 = COPY %2
...

