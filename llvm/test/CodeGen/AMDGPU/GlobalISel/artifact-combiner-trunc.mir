name: trunc_ext
tracksRegLiveness: false

body: |
  bb.0:
    ; Test that trunc(sext (trunc (...))) is replaced with source.
    ; FLOAT-LABEL: name: trunc_ext
    ; FLOAT: [[DEF:%[0-9]+]]:_(s32) = G_IMPLICIT_DEF
    ; FLOAT-NEXT: $vgpr0 = COPY [[DEF]](s32)
