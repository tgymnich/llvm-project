    %7:vgpr(i32) = G_SMIN %6, %3
    %8:vgpr(i16) = G_TRUNC %5
    %9:vgpr(i16) = G_TRUNC %7
    %10:vgpr(<2 x i16>) = G_BUILD_VECTOR %8, %9
    S_ENDPGM 0, implicit %10
