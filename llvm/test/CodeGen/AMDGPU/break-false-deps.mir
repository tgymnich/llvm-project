# RUN: llc -mtriple=amdgpu11.00 -run-pass=break-false-deps -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu11.00 -passes=break-false-deps -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=amdgpu11.00 -start-before=break-false-deps -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=ASM

---
name: movrelsd
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr8_vgpr9, $m0

    ; CHECK-LABEL: name: movrelsd
    ; CHECK: V_MOVRELSD_B32_e32 $vgpr8, undef $vgpr0,
    ; CHECK-NEXT: V_MOVRELSD_B32_e64 $vgpr8, undef $vgpr0,
    ; ASM-LABEL: movrelsd:
    ; ASM: v_movrelsd_b32_e32 v8, v0
    ; ASM: v_movrelsd_b32_e64 v8, v0
    V_MOVRELSD_B32_e32 $vgpr8, undef $vgpr0, implicit $m0, implicit $exec, implicit-def $vgpr8_vgpr9, implicit $vgpr8_vgpr9(tied-def 4), implicit $vgpr0_vgpr1
    V_MOVRELSD_B32_e64 $vgpr8, undef $vgpr0, implicit $m0, implicit $exec, implicit-def $vgpr8_vgpr9, implicit $vgpr8_vgpr9(tied-def 4), implicit $vgpr0_vgpr1
    EXP_DONE 0, $vgpr8, $vgpr9, undef $vgpr10, undef $vgpr11, 0, 0, 3, implicit $exec
    S_ENDPGM 0
...

---
name: movrelsd_2
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0_vgpr1, $vgpr8_vgpr9, $m0

    ; CHECK-LABEL: name: movrelsd_2
    ; CHECK: V_MOVRELSD_2_B32_e32 $vgpr8, undef $vgpr0,
    ; CHECK-NEXT: V_MOVRELSD_2_B32_e64 $vgpr8, undef $vgpr0,
    ; ASM-LABEL: movrelsd_2:
    ; ASM: v_movrelsd_2_b32_e32 v8, v0
    ; ASM: v_movrelsd_2_b32_e64 v8, v0
    V_MOVRELSD_2_B32_e32 $vgpr8, undef $vgpr0, implicit $m0, implicit $exec, implicit-def $vgpr8_vgpr9, implicit $vgpr8_vgpr9(tied-def 4), implicit $vgpr0_vgpr1
    V_MOVRELSD_2_B32_e64 $vgpr8, undef $vgpr0, implicit $m0, implicit $exec, implicit-def $vgpr8_vgpr9, implicit $vgpr8_vgpr9(tied-def 4), implicit $vgpr0_vgpr1
    EXP_DONE 0, $vgpr8, $vgpr9, undef $vgpr10, undef $vgpr11, 0, 0, 3, implicit $exec
    S_ENDPGM 0
...

---
name: pack
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $vgpr0, $vgpr3

    ; CHECK-LABEL: name: pack
    ; CHECK: V_CVT_PKRTZ_F16_F32_e64 0, $vgpr0, 0, undef $vgpr0,
    ; ASM-LABEL: pack:
    ; ASM: v_mul_f32_e32 v1, 2.0, v3
    ; ASM-NEXT: v_cvt_pk_rtz_f16_f32_e64 v2, v0, v0
    $vgpr1 = V_MUL_F32_e32 1073741824, $vgpr3, implicit $mode, implicit $exec
    $vgpr2 = V_CVT_PKRTZ_F16_F32_e64 0, $vgpr0, 0, undef $vgpr1, 0, 0, implicit $mode, implicit $exec
    EXP_DONE 0, $vgpr2, undef $vgpr4, undef $vgpr5, undef $vgpr6, 0, 0, 1, implicit $exec
    S_ENDPGM 0
...
